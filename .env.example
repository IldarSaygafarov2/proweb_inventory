# Локально можно оставить как есть. На проде — см. комментарии ниже.

DJANGO_SECRET_KEY=change-me
# На проде: 0
DJANGO_DEBUG=1
# На проде: добавить сюда IP сервера, например 203.0.113.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=pcinventory
POSTGRES_USER=pcinventory
# На проде — сгенерировать стойкий пароль
POSTGRES_PASSWORD=change-me

# Суперпользователь Django создаётся автоматически при старте контейнера
# (если ещё не существует). На проде — сменить пароль.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

DB_HOST=localhost
DB_PORT=5432

# Порт, на котором backend публикуется на 127.0.0.1 (наружу сервера не
# смотрит). Системный nginx (см. nginx/pcinventory.conf) проксирует сюда.
HTTP_PORT=8000

# Нужен только если открываете Django admin через HTTPS (прокси/домен).
# Для обычного http по IP — можно оставить пустым.
CSRF_TRUSTED_ORIGINS=
