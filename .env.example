DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=pcinventory
POSTGRES_USER=pcinventory
POSTGRES_PASSWORD=change-me

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

DB_HOST=localhost
DB_PORT=5432

HTTP_PORT=8000

CSRF_TRUSTED_ORIGINS=

# Уведомления в Telegram-группу о новых ПК и изменениях характеристик.
# Токен бота - от @BotFather. CHANNEL_ID - id группы (отрицательное число);
# проще всего узнать так: добавить бота в группу, написать туда любое
# сообщение, затем открыть https://api.telegram.org/bot<TOKEN>/getUpdates
# и найти "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=change-me
CHANNEL_ID=change-me
